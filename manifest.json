{
  "manifest_version": 3,
  "name": "YouTube Volume Fix",
  "version": "1.3.2",
  "description": "Perceptual volume curve for YouTube",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-volume-fix@magshproget",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "options.html",
    "default_title": "YouTube Volume Fix",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
